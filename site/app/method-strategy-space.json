      ],
      "choice_points": [],
      "boundary": "尚未形式化建模；不得据此声称可优化空间存在"
    },
    "survey": {
      "status": "pending",
      "hard_constraints": [
        "survey.sampling",
        "survey.instrument",
        "survey.consent"
      ],
      "choice_points": [],
      "boundary": "尚未形式化建模；不得据此声称可优化空间存在"
    },
    "design-science": {
      "status": "pending",
      "hard_constraints": [
        "dsr.problem",
        "dsr.evaluation"
      ],
      "choice_points": [],
      "boundary": "尚未形式化建模；不得据此声称可优化空间存在"
    },
    "action-research": {
      "status": "pending",
      "hard_constraints": [
        "action.cycles",
