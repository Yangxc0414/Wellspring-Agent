        "S0",
        "S1",
        "S1b",
        "S8-S12"
      ],
      "guidelines": [
        {
          "key": "kitchenham2007",
          "citation": "Kitchenham & Charters (2007). Guidelines for Performing Systematic Literature Reviews in Software Engineering. EBSE Technical Report.",
          "mandates": "研究问题、检索协议、检索式与数据库、纳入/排除标准、质量评估、数据抽取与综合"
        },
        {
          "key": "wohlin2014",
          "citation": "Wohlin (2014). Guidelines for Snowballing in Systematic Literature Studies and a Replication in Software Engineering. EASE.",
          "mandates": "起始集（start set）的合理性、后向/前向滚雪球、与数据库检索的合并报告"
        },
        {
          "key": "page2021",
          "citation": "Page et al. (2021). The PRISMA 2020 statement. BMJ.",
          "mandates": "识别/筛选/纳入的数量流与排除理由"
        }
      ],
      "protocol_fields": [
        "research_questions",
        "search_strategy",
        "databases",
        "search_date",
        "inclusion_criteria",
        "exclusion_criteria",
        "quality_assessment",
        "data_extraction",
        "synthesis_method"
      ],
      "threat_focus": [
        "construct",
        "external",
        "reproducibility"
      ],
      "artifacts": [
        "S1 文献台账",
        "检索式与检索日期",
        "纳入/排除清单",
        "质量评估表",
        "PRISMA 计数",
        "综合矩阵"
      ],
      "cannot_support": [
        "因果效应",
        "新方法的性能",
        "未发表工业实践的代表性"
      ],
      "checks": [
        {
          "id": "slr.protocol",
          "severity": "blocker",
          "requires": [
            "research_questions",
            "search_strategy",
            "inclusion_criteria",
            "exclusion_criteria"
          ]
        },
        {
          "id": "slr.reproducible_search",
          "severity": "warn",
          "requires": [
            "databases",
            "search_date"
          ]
        },
        {
          "id": "slr.quality",
          "severity": "warn",
          "requires": [
            "quality_assessment"
          ]
        },
        {
          "id": "slr.screening_agreement",
          "severity": "warn",
          "requires": [
            "screening_agreement"
          ]
        }
      ],
      "reporting_sections": [
        "研究问题",
        "协议与偏离",
        "检索策略（数据库/检索式/日期）",
        "纳入排除与筛选一致性",
        "质量评估",
        "数据抽取",
        "综合与证据地图",
        "效度威胁",
        "复现入口"
      ],
      "stage_tasks": {
        "S0": "把问题收成可检索的 RQ；声明综述类型（映射式/系统式）与更新策略",
        "S1": "先写检索协议再检索；记录数据库、检索式、日期、命中数；滚雪球需给出 start set 依据",
        "S1b": "按主题×来源建矩阵；标注一致点/张力/未使用来源；报告覆盖缺口",
        "S8-S12": "按 PRISMA 与 Kitchenham 报告结构写；检索日期与计数必须可复现"
      }
    },
