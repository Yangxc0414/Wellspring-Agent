        {
          "id": "mining.dedup",
          "severity": "blocker",
          "requires": [
            "dedup_policy"
          ]
        },
        {
          "id": "mining.license",
          "severity": "warn",
          "requires": [
            "license_check"
          ]
        },
        {
          "id": "mining.label_source",
          "severity": "warn",
          "requires": [
            "label_source"
          ]
        },
        {
          "id": "mining.analysis",
          "severity": "warn",
          "requires": [
