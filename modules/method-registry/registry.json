    },
    {
      "id": "S1b",
      "name": "跨来源综合矩阵"
    },
    {
      "id": "S2-S3",
      "name": "缺口与创新评审"
    },
    {
      "id": "S4",
      "name": "实验/研究设计"
    },
    {
      "id": "S5",
      "name": "执行与证据"
    },
    {
      "id": "S5b",
      "name": "Claim 草稿与签核"
    },
    {
      "id": "S6",
      "name": "图表"
    },
    {
      "id": "S8-S12",
      "name": "写作与评审"
    },
    {
      "id": "S13-S16",
      "name": "闭包与签核"
    }
  ],
  "methods": [
    {
      "id": "systematic-literature-review",
      "name_zh": "系统文献综述（SLR）",
      "name_en": "Systematic Literature Review",
      "fit_stages": [
        "S0",
        "S1",
        "S1b",
        "S8-S12"
      ],
      "guidelines": [
        {
          "key": "kitchenham2007",
          "citation": "Kitchenham & Charters (2007). Guidelines for Performing Systematic Literature Reviews in Software Engineering. EBSE Technical Report.",
          "mandates": "研究问题、检索协议、检索式与数据库、纳入/排除标准、质量评估、数据抽取与综合"
        },
        {
          "key": "wohlin2014",
          "citation": "Wohlin (2014). Guidelines for Snowballing in Systematic Literature Studies and a Replication in Software Engineering. EASE.",
          "mandates": "起始集（start set）的合理性、后向/前向滚雪球、与数据库检索的合并报告"
        },
        {
          "key": "page2021",
          "citation": "Page et al. (2021). The PRISMA 2020 statement. BMJ.",
          "mandates": "识别/筛选/纳入的数量流与排除理由"
        }
      ],
      "protocol_fields": [
        "research_questions",
        "search_strategy",
        "databases",
        "search_date",
        "inclusion_criteria",
        "exclusion_criteria",
        "quality_assessment",
        "data_extraction",
        "synthesis_method"
      ],
      "threat_focus": [
        "construct",
        "external",
        "reproducibility"
      ],
      "artifacts": [
        "S1 文献台账",
        "检索式与检索日期",
        "纳入/排除清单",
        "质量评估表",
        "PRISMA 计数",
        "综合矩阵"
      ],
      "cannot_support": [
        "因果效应",
        "新方法的性能",
        "未发表工业实践的代表性"
      ],
      "checks": [
        {
          "id": "slr.protocol",
          "severity": "blocker",
          "requires": [
            "research_questions",
            "search_strategy",
            "inclusion_criteria",
            "exclusion_criteria"
          ]
        },
        {
          "id": "slr.reproducible_search",
          "severity": "warn",
          "requires": [
            "databases",
            "search_date"
          ]
        },
        {
          "id": "slr.quality",
          "severity": "warn",
          "requires": [
            "quality_assessment"
          ]
        },
        {
          "id": "slr.screening_agreement",
          "severity": "warn",
          "requires": [
            "screening_agreement"
          ]
        }
      ],
      "reporting_sections": [
        "研究问题",
        "协议与偏离",
        "检索策略（数据库/检索式/日期）",
        "纳入排除与筛选一致性",
        "质量评估",
        "数据抽取",
        "综合与证据地图",
        "效度威胁",
        "复现入口"
      ],
      "stage_tasks": {
        "S0": "把问题收成可检索的 RQ；声明综述类型（映射式/系统式）与更新策略",
        "S1": "先写检索协议再检索；记录数据库、检索式、日期、命中数；滚雪球需给出 start set 依据",
        "S1b": "按主题×来源建矩阵；标注一致点/张力/未使用来源；报告覆盖缺口",
        "S8-S12": "按 PRISMA 与 Kitchenham 报告结构写；检索日期与计数必须可复现"
      },
      "inputs": [
        "研究问题（RQ）",
        "检索协议：检索式 / 数据库 / 检索日期",
        "纳入与排除标准",
        "质量评估清单"
      ],
      "evidence_sources": [
        "已发表研究全文（期刊 / 会议）",
        "预印本与灰色文献（显式声明）",
        "各原始研究自身报告的数据（二手证据）"
      ],
      "evaluation_dimensions": [
        {
          "dimension": "可复现性：检索与筛选可被他人重放",
          "basis": "Kitchenham 2007 §协议与检索策略"
        },
        {
          "dimension": "筛选一致性：多人按标准筛选并报告数量流",
          "basis": "PRISMA 2020（识别/筛选/纳入）"
        },
        {
          "dimension": "外部效度受原始研究集合限制",
          "basis": "Wohlin 2014（滚雪球与数据库合并）"
        }
      ],
      "tags": [
        "预注册协议",
        "筛选标准",
        "质量评估",
        "综合矩阵"
      ],
      "composition_id": "confirmatory"
    },
