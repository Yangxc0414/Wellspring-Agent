      "reporting_sections": [
        "背景与假设",
        "因子/水平/对象",
        "随机化与区组",
        "测量与工具",
        "执行与偏离",
        "分析（效应量+区间）",
        "效度威胁",
        "复现材料"
      ],
      "stage_tasks": {
        "S2-S3": "把假设写成可操控的因子与水平；先做功效预判再承诺样本量",
        "S4": "预注册：随机化、区组、主指标、分析计划、停止规则；设计冻结后才执行",
        "S5": "执行记录分配与偏离；不得事后改主指标",
        "S5b": "claim 只能来自预注册主比较；区间跨零即 undecidable",
        "S8-S12": "按 Wohlin/Jedlitschka 结构报告，效度威胁单列"
      },
      "inputs": [
        "可操控因子与水平的假设",
        "随机化与区组计划",
        "样本量与功效分析",
        "分析计划与停止规则"
      ],
      "evidence_sources": [
        "受控环境下对实验单元的一手测量",
        "分配与偏离记录（随机化留痕）"
      ],
      "evaluation_dimensions": [
        {
          "dimension": "内部效度：因果来自控制 + 随机",
          "basis": "Cook & Campbell 1979；Wohlin 2014 效度框架"
        },
        {
          "dimension": "统计结论效度：功效与检验",
          "basis": "experiment.power / experiment.analysis_plan 检查"
        },
        {
          "dimension": "构念效度：任务是否代表目标构念",
          "basis": "threat_focus=construct"
        },
        {
          "dimension": "外部效度：单元与情境的推广范围",
          "basis": "threat_focus=external"
        }
      ],
      "tags": [
        "预注册协议",
        "随机化",
        "对照组",
        "区组",
        "功效分析",
        "停止规则"
      ],
      "composition_id": "confirmatory"
    },
