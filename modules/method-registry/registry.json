      "reporting_sections": [
        "抽样框与筛选",
        "时间窗与切分",
        "去重与标签",
        "许可与伦理",
        "抽取管线与快照",
        "效度威胁（尤其生态与时间漂移）"
      ],
      "stage_tasks": {
        "S1": "确定抽样框（哪些项目、为何排除）；核对镜像仓库与复刻",
        "S4": "时间切分必须先于建模；去重策略与标签来源写进预注册",
        "S5": "记录抽取脚本、快照哈希与许可证；重复运行必须得到同一快照",
        "S5b": "claim 的 scope 必须写清语言/生态/时间窗；不得外推为因果"
      },
      "inputs": [
        "抽样框与项目选择规则",
        "时间窗与时间切分定义",
        "标签来源（path/message 启发式）",
        "抽取脚本与许可证核对"
      ],
      "evidence_sources": [
        "代码仓库历史（commit / issue / PR 记录）",
        "仓库元数据与镜像快照（sha 固定）"
      ],
      "evaluation_dimensions": [
        {
          "dimension": "构造效度：标签启发式是否测到目标构念",
          "basis": "threat_focus=construct；capsule warning"
        },
        {
          "dimension": "可复现性：重复运行必须得到同一快照",
          "basis": "run contract：evidence.hash / artifacts.required"
        },
        {
          "dimension": "外部效度：语言 / 生态 / 时间窗范围",
          "basis": "threat_focus=external；claim scope 规则"
        },
        {
          "dimension": "内部因果效度不可支持（观察性）",
          "basis": "cannot_support：因果机制"
        }
      ],
      "tags": [
        "预注册协议",
        "抽样框",
        "时间切分",
        "去重策略",
        "标签启发式声明",
        "许可核对",
        "快照哈希"
      ],
      "composition_id": "exploratory"
    },
